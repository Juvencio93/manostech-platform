# .env.example

# API Configuration
API_URL=http://localhost:3000/api
API_TIMEOUT=30000

# Supabase Configuration
SUPABASE_URL=https://seu-projeto.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Server Configuration
PORTO=8000
NODE_ENV=development

# Application Configuration
APP_NAME=ManosTech Platform
APP_VERSION=1.0.0
APP_DESCRIPTION=Plataforma de gerenciamento de eventos e marketing local

# Authentication
JWT_SECRET=sua-chave-secreta-muito-segura-aqui
JWT_EXPIRATION=7d

# Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=manostech
DB_USER=postgres
DB_PASSWORD=senha-segura

# Email Configuration (para envio de emails)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=seu-email@gmail.com
SMTP_PASSWORD=sua-senha-app
SMTP_FROM=noreply@manostech.com

# AWS S3 (para upload de arquivos)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=sua-chave-aws
AWS_SECRET_ACCESS_KEY=sua-chave-secreta-aws
AWS_BUCKET=manostech-uploads

# Google Analytics
GOOGLE_ANALYTICS_ID=UA-XXXXXXXXX-X

# Feature Flags
ENABLE_REALTIME=true
ENABLE_ANALYTICS=true
ENABLE_BACKUP=true
ENABLE_EMAIL_NOTIFICATIONS=true

# Logging
LOG_LEVEL=info
LOG_FILE=./logs/app.log

# CORS
CORS_ORIGIN=http://localhost:8000
CORS_METHODS=GET,POST,PUT,DELETE,PATCH

# Security
RATE_LIMIT=100
SESSION_TIMEOUT=3600000
PASSWORD_MIN_LENGTH=8
